static int extra_menu_input(uint32_t pressed,SceCtrlData *pad,float dt){
 (void)pad;(void)dt;
 if(screen==14){if(pressed&PSP_CTRL_LEFT)survival_cursor=survival_cursor/5*5+(survival_cursor%5+4)%5;if(pressed&PSP_CTRL_RIGHT)survival_cursor=survival_cursor/5*5+(survival_cursor%5+1)%5;if(pressed&PSP_CTRL_LTRIGGER)survival_cursor=(survival_cursor+10)%15;if(pressed&PSP_CTRL_RTRIGGER)survival_cursor=(survival_cursor+5)%15;if(pressed&PSP_CTRL_UP)survival_cursor=(survival_cursor+10)%15;if(pressed&PSP_CTRL_DOWN)survival_cursor=(survival_cursor+5)%15;if(survival_cursor>=10)survival_cursor=12;if(pressed&PSP_CTRL_CROSS)open_extra(EXTRA_SURVIVAL,survival_cursor%5,survival_cursor/5);if(pressed&PSP_CTRL_TRIANGLE)resume_extra();if(pressed&PSP_CTRL_CIRCLE)screen=6;return 1;}
 if(screen==15){if(pressed&PSP_CTRL_LEFT)puzzle_cursor=(puzzle_cursor+9)%10;if(pressed&PSP_CTRL_RIGHT)puzzle_cursor=(puzzle_cursor+1)%10;if(pressed&(PSP_CTRL_UP|PSP_CTRL_DOWN))puzzle_cursor=(puzzle_cursor+5)%10;if(pressed&(PSP_CTRL_LTRIGGER|PSP_CTRL_RTRIGGER))puzzle_family^=1;if(pressed&PSP_CTRL_CROSS)open_extra(puzzle_family?EXTRA_IZOMBIE:EXTRA_VASE,puzzle_cursor,0);if(pressed&PSP_CTRL_TRIANGLE)resume_extra();if(pressed&PSP_CTRL_CIRCLE)screen=6;return 1;}
 if(screen==16){int cap=garden_view==GARDEN_MAIN?32:garden_view==GARDEN_BARROW?1:8;
  if(garden_sale>=0){if(pressed&PSP_CTRL_CROSS){garden_flush();garden_sell(&player,garden_sale);foley_play(FOLEY_MONEYFALLS);garden_sale=-1;profile_save(&player,profile_path);}if(pressed&PSP_CTRL_CIRCLE)garden_sale=-1;return 1;}
  if(pressed&PSP_CTRL_LEFT)garden_slot=(garden_slot+cap-1)%cap;if(pressed&PSP_CTRL_RIGHT)garden_slot=(garden_slot+1)%cap;if(pressed&PSP_CTRL_UP)garden_slot=(garden_slot+cap-8)%cap;if(pressed&PSP_CTRL_DOWN)garden_slot=(garden_slot+8)%cap;if(pressed&PSP_CTRL_LTRIGGER)garden_tool=(garden_tool+TOOL_COUNT-1)%TOOL_COUNT;if(pressed&PSP_CTRL_RTRIGGER)garden_tool=(garden_tool+1)%TOOL_COUNT;
  if(pressed&PSP_CTRL_SQUARE){if(garden_collect(&player))foley_play(FOLEY_COIN);if(!garden_pending())profile_save(&player,profile_path);}
  if(pressed&PSP_CTRL_TRIANGLE){garden_flush();screen=22;garden_picker_cursor=garden_view;}
  if(pressed&PSP_CTRL_CROSS){int i=garden_find(&player,garden_view,garden_slot);if(garden_held>=0){garden_flush();if(garden_move(&player,garden_held,garden_view,garden_slot)){garden_held=-1;foley_play(FOLEY_DROP);profile_save(&player,profile_path);}else notify("THIS MOVE NEEDS AN EMPTY SLOT AND THE RIGHT TOOL");}
   else if(garden_tool==TOOL_GLOVE||garden_tool==TOOL_BARROW){if(i>=0&&!garden_busy(i)&&(garden_tool==TOOL_GLOVE?player.purchases[SHOP_GLOVE]:player.purchases[SHOP_BARROW])){garden_held=i;foley_play(FOLEY_FLOOP);}}else if(garden_tool==TOOL_SELL){if(!garden_busy(i))garden_sale=i;}else if(garden_action_start(i,garden_tool)){}else notify("PLANT DOES NOT NEED THIS, OR YOU NEED SUPPLIES");}
  if(pressed&PSP_CTRL_START){garden_flush();profile_save(&player,profile_path);store_return=16;screen=9;store_cursor=14;}if(pressed&PSP_CTRL_CIRCLE){garden_flush();garden_held=-1;garden_collect(&player);profile_save(&player,profile_path);screen=garden_return;garden_return=11;}return 1;}
 if(screen==17){if(pressed&PSP_CTRL_CROSS){if(garden_tree_feed(&player)){profile_save(&player,profile_path);audio_play(SFX_PLANT);}else notify("BUY TREE FOOD IN THE SHOP");}if(pressed&PSP_CTRL_SQUARE){player.garden.tree_tip=player.garden.tree_height>3?2+player.garden.rng%((player.garden.tree_height<49?player.garden.tree_height:49)-2):1;profile_save(&player,profile_path);}if(pressed&PSP_CTRL_START){store_return=17;screen=9;store_cursor=26;}if(pressed&PSP_CTRL_CIRCLE)screen=16;return 1;}
 return 0;
}
