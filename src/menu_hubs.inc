static int collection_cursor,adventure_cursor,options_return;
static const int collection_ids[5]={3,4,9,2,12};
static void open_collection(int id){
 if(id==3){if(player.highest>=25){store_return=11;screen=9;store_cursor=0;}else notify("Find Crazy Dave's car keys in Adventure.");}
 else if(id==4){if(player.highest>=15){screen=10;book_cursor=book_zombies=book_scroll=0;}else notify("Find the Almanac in Adventure.");}
 else if(id==2){screen=8;note_cursor=0;}
 else if(id==9){if(player.highest>=45){garden_initialize(&player,(int64_t)time(NULL));garden_view=garden_slot=0;garden_return=11;screen=16;garden_saved_time=(int64_t)time(NULL);if(!(player.garden.story_seen&(UINT64_C(1)<<60))){player.garden.story_seen|=UINT64_C(1)<<60;story_begin(2100,16,0,0);}}else notify("Find the watering can in Adventure.");}
 else if(id==12)screen=0;
}
static void draw_more_ways(void){int id=more_id(more_cursor),frame=id==1?0:id==8?1:id==7?2:3;render_image(&assets[A_MENU_MODES],0,0,480,272,frame,WHITE);for(int n=0;n<3;n++)if(!challenge_gate(n==0?2:n==1?1:0))render_image(&assets[A_CHALLENGE_LOCK],(int[]){146,181,226}[n],(int[]){112,151,115}[n],18,23,0,WHITE);ui_hint(id==1?"Mini-games   X: Open   O: Back":id==8?"Puzzles   X: Open   O: Back":id==7?"Survival   X: Open   O: Back":"X: Main menu   O: Back");}
static void draw_collection_menu(void){render_image(&assets[A_MENU_COLLECTION],0,0,480,272,collection_cursor,WHITE);static const char *labels[]={"Crazy Dave's shop","Suburban Almanac","Zen Garden","Zombie notes","Main menu"};ui_hint(message_time>0?message:labels[collection_cursor]);}
static void draw_adventure_menu(void){render_image(&assets[A_MENU_MAIN],0,0,480,272,0,WHITE);ui_dialog(118,55,244,159,"Adventure");ui_button(146,91,188,"Continue",adventure_cursor==0);ui_button(146,126,188,"Replay levels",adventure_cursor==1);ui_button(146,161,188,"New Adventure",adventure_cursor==2);ui_hint("D-pad: Select   X: Open   O: Back");}
static void draw_credits_menu(void){render_image(&assets[A_MENU_MAIN],0,0,480,272,(can_resume?0:5)+3,WHITE);ui_dialog(103,48,274,177,"Credits and extras");ui_button(128,91,224,"Watch the ending",credits_cursor==0);ui_button(128,127,224,"Animation gallery",credits_cursor==1);ui_button(128,163,224,"Back",credits_cursor==2);}
static void draw_garden_picker(void){render_background(&assets[A_GARDEN_BG]);ui_dialog(104,33,272,204,"Gardens");static const char *names[]={"Zen Garden","Mushroom Garden","Aquarium Garden","Wheelbarrow","Tree of Wisdom"};for(int i=0;i<5;i++)ui_button(129,69+i*30,222,names[i],garden_picker_cursor==i);ui_hint("Up/Down: Select   X: Visit   O: Back");}
static int hub_input(uint32_t pressed){
 if(screen==11){if(pressed&(PSP_CTRL_LEFT|PSP_CTRL_UP))collection_cursor=(collection_cursor+4)%5;if(pressed&(PSP_CTRL_RIGHT|PSP_CTRL_DOWN))collection_cursor=(collection_cursor+1)%5;if(pressed&PSP_CTRL_CROSS)open_collection(collection_ids[collection_cursor]);if(pressed&PSP_CTRL_CIRCLE)screen=0;if(pressed&PSP_CTRL_START){options_return=11;screen=4;}return 1;}
 if(screen==21){if(pressed&PSP_CTRL_UP)adventure_cursor=(adventure_cursor+2)%3;if(pressed&PSP_CTRL_DOWN)adventure_cursor=(adventure_cursor+1)%3;if(pressed&PSP_CTRL_CIRCLE)screen=0;if(pressed&PSP_CTRL_CROSS){if(adventure_cursor==0)open_adventure();else if(adventure_cursor==1){screen=5;replay_cursor=0;}else new_game();}return 1;}
 if(screen==22){if(pressed&PSP_CTRL_UP)garden_picker_cursor=(garden_picker_cursor+4)%5;if(pressed&PSP_CTRL_DOWN)garden_picker_cursor=(garden_picker_cursor+1)%5;if(pressed&PSP_CTRL_CIRCLE)screen=16;if(pressed&PSP_CTRL_CROSS){int choice=garden_picker_cursor;int owned=choice==0||(choice==1&&player.purchases[SHOP_MUSHROOM_GARDEN])||(choice==2&&player.purchases[SHOP_AQUARIUM])||(choice==3&&player.purchases[SHOP_BARROW])||(choice==4&&player.purchases[SHOP_TREE]);if(!owned){notify("Buy this garden in Crazy Dave's shop.");return 1;}garden_collect(&player);profile_save(&player,profile_path);if(choice==4){screen=17;if(!(player.garden.story_seen&(UINT64_C(1)<<61))){player.garden.story_seen|=UINT64_C(1)<<61;story_begin(3200,17,0,0);}}else{garden_view=choice;garden_slot=0;screen=16;}}return 1;}
 return 0;
}
