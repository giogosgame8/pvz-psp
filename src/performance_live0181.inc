/* Exercise real fixed-step combat and streaming effects during the timed sample. */
static unsigned live_updates,live_replenished;static float live_combat_seconds,live_music_timer;
static void live_combat_setup(int pool){
 game_start_level(&game,pool?29:9,0x1860+pool);game.level_flags|=LEVEL_READY;game.spawn_timer=100000;game.sun=100000;game.seed_mask=UINT64_MAX;game.unlocked_mask=(UINT64_C(1)<<ALL_SEEDS)-1;screen=1;paused=help=gallery=0;
 for(int r=0;r<game_rows(&game);r++)for(int c=0;c<6;c++){
  int k=c==0?SUNFLOWER:c==1?WALLNUT:c%3==0?SNOW:c%3==1?REPEATER:PEA;
  if(pool&&game_water_row(&game,r))game_place(&game,r,c,LILY);
  *game_seed_cooldown(&game,k)=0;game_place(&game,r,c,k);
 }
 for(int n=0;n<(pool?42:30);n++){int r=n%game_rows(&game),kind=n%6==0?Z_BUCKET:n%3==0?Z_CONE:Z_NORMAL;game_spawn_zombie(&game,r,kind,285+n/game_rows(&game)*24);}
 reset_level_ui();read_costs();debug_info=1;live_replenished=live_updates=0;live_combat_seconds=0;live_music_timer=0;
}
static void live_combat_step(float dt,float *accumulator){
 live_updates+=advance_game_frame(&game,dt,accumulator);live_combat_seconds+=dt;
 /* Keep the synthetic scene populated; ordinary collision, damage, projectiles,
    sounds and deaths run through the same path used by real gameplay. */
 game.status=PLAYING;game.spawn_timer=100000;
 for(int r=0;r<game_rows(&game);r++)for(int c=0;c<6;c++)if(game.plants[r][c].kind>=0)game.plants[r][c].hp=game.plants[r][c].kind==WALLNUT?4000:300;
 for(int n=0;n<MAX_ZOMBIES;n++)if(game.zombies[n].used&&game.zombies[n].death<=0&&game.zombies[n].x<GRID_X+10)game.zombies[n].x=410;
 int target=live_phase?42:30;for(int count=game_alive(&game);count<target;count++){int row=live_replenished++%game_rows(&game),kind=live_replenished%6==0?Z_BUCKET:live_replenished%3==0?Z_CONE:Z_NORMAL;if(game_spawn_zombie(&game,row,kind,405+live_replenished%5*12)<0)break;}
 game_collect(&game);
 /* Streamed hits/shots/groans are generated by combat; also keep rain and a
    periodic thunder request active during the pool stress case. */
 live_music_timer+=dt;if(live_phase&&live_music_timer>=8){live_music_timer=0;foley_play(FOLEY_THUNDER);}
}
static void live_combat_report(FILE *log,const char *label){
 if(log){fprintf(log,"LIVE %s: simulated %.3f seconds, %u fixed updates, %d kills, %u replacements, %d zombies alive\n",label,live_combat_seconds,live_updates,game.kills,live_replenished,game_alive(&game));foley_report(log);animation_cache_report(log);fflush(log);}
 FILE *f=fopen("selftest.txt","a");if(f){int ok=live_updates>3000&&game.kills>0&&game_alive(&game)>20&&foley_ok()&&animation_cache_ok();fprintf(f,"live %s combat with simulation, effects and streamed music: %s\n",label,ok?"PASS":"FAIL");fclose(f);test_ok&=ok;}
}
